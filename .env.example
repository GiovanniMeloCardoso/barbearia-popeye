# Exemplo de configuração de variáveis de ambiente
# Copie este arquivo para .env no ambiente local ou configure estas variáveis no painel da Vercel / PythonAnywhere

# URL de conexão com o banco de dados (ex: Supabase, PostgreSQL)
DATABASE_URL=postgresql://usuario:senha@host:porta/banco

# Modo debug (NUNCA deixe True em produção)
DEBUG=False

# Chave secreta única gerada para o Django (gere uma chave forte e nunca exponha)
SECRET_KEY=sua-chave-secreta-forte-aqui

# Hosts permitidos separados por vírgula
ALLOWED_HOSTS=seusite.com,www.seusite.com,agendamentobarbearia.pythonanywhere.com,.vercel.app
